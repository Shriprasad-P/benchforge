# Copy to .env in this directory. Existing process environment wins.
# The server loads .env on startup; restart after changes.

BENCHFORGE_DATA=./data
BENCHFORGE_IMAGE=python:3.12-slim

# Chat completions: any OpenAI-compatible HTTP API.
# Examples:
#   OpenAI     https://api.openai.com/v1
#   Groq       https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Ollama     http://127.0.0.1:11434/v1
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral    https://api.mistral.ai/v1
#   Together   https://api.together.xyz/v1
#   Azure      https://{resource}.openai.azure.com/openai/deployments/{name}?api-version=2024-10-21
# OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL still work as aliases.
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=
PROVIDER_MODEL=
# bearer (default) | api-key (Azure) | none (local Ollama)
PROVIDER_AUTH=bearer
PROVIDER_MAX_TOKENS=4096

# Anthropic Messages API (not chat/completions).
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
