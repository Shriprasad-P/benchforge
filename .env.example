# Export these variables in your shell; .env is not loaded automatically.
BENCHFORGE_DATA=./data

# For reproducible evaluations, replace this tag with an image digest.
BENCHFORGE_IMAGE=python:3.12-slim

# Optional OpenAI-compatible provider.
# Credentials stay in the API process and are not sent into containers.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
